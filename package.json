{
  "name": "hackathon-wdcc",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -s first \"next dev\" \"wait-on http://localhost:3000 && set ELECTRON_RUN_AS_NODE=&& electron .\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:setup": "node --experimental-strip-types scripts/db-setup.ts",
    "electron": "set ELECTRON_RUN_AS_NODE=&& electron ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.21.2",
    "next": "16.2.12",
    "openai": "^7.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "webgazer": "^3.5.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
